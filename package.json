{
  "name": "stormscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node scripts/e2e.mjs http://localhost:5173/ e2e-shots",
    "qa:prod": "node scripts/prod-suite.mjs https://stormscope-two.vercel.app/",
    "qa:local": "node scripts/prod-suite.mjs http://localhost:5174/ --force"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "Mobile-first PWA weather map: live radar, rainfall forecast, flood risk, river gauges, station obs and nowcast on 3D terrain."
